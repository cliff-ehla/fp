rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Keep in sync with ADMIN_EMAILS in src/lib/fp5.js.
    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'andiolai@gmail.com',
        'contact@studioleung.com',
        'fukkuen.work@gmail.com',
        'hatch.mm@gmail.com',
        'hugoymh@gmail.com',
        'johnchow0829@gmail.com',
        'kinlam8@gmail.com',
        'kmcheng212@gmail.com',
        'knellmc@yahoo.com.hk',
        'lailindach@gmail.com',
        'lauhoc@gmail.com',
        'lisankitandy@gmail.com',
        'ngsing519@gmail.com',
        'sinyichoi89@gmail.com',
        'smhect@cityu.edu.hk',
        'smllai@cityu.edu.hk',
        'waileunglai2014@gmail.com',
        'winsome.wd@gmail.com',
        'wongchunhoi9@gmail.com',
        'yanwywinnie@gmail.com'
      ];
    }

    match /media/{mediaId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // TODO: tighten these — tracked as follow-up, out of scope here.
    // Listed explicitly (rather than a blanket {document=**} catch-all) so
    // they can't accidentally OR-override the restricted /media rules above,
    // since Firestore grants access if ANY matching rule allows it.
    match /posts/{docId} {
      allow read, write: if true;
    }
    match /events/{docId} {
      allow read, write: if true;
    }
    match /categories/{docId} {
      allow read, write: if true;
    }
    match /authors/{docId} {
      allow read, write: if true;
    }
    match /tags/{docId} {
      allow read, write: if true;
    }
    match /abouts/{docId} {
      allow read, write: if true;
    }
    match /vcd_collection/{docId} {
      allow read, write: if true;
    }

    match /fp5_events/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
